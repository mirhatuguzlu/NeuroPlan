# Edge Function sırları. supabase/functions/.env.prod olarak kopyala (git'e girmez), doldur ve gönder:
#   supabase secrets set --env-file supabase/functions/.env.prod   (bağlı projeye gider)
# SUPABASE_URL, SUPABASE_ANON_KEY ve SUPABASE_SERVICE_ROLE_KEY Supabase tarafından kendiliğinden verilir; buraya yazma.

# Sesli sohbet (LiveKit Cloud → Settings → API Keys)
LIVEKIT_URL=wss://PROJE-ADI.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Mesaj push bildirimi: veritabanı tetikleyicisiyle paylaşılan rastgele uzun sır (Vault'taki push_webhook_secret ile AYNI)
PUSH_WEBHOOK_SECRET=
# Firebase servis hesabı JSON'unun TAMAMI tek satırda (Firebase konsolu → Proje ayarları → Hizmet hesapları)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}
