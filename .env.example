# Copy to .env and fill in. .env is git-ignored.
# Run: flutter run --dart-define-from-file=.env
# Only the public anon / publishable key belongs here. NEVER the service_role / secret key.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# Google Cloud "Web application" OAuth client ID (same one configured in Supabase → Auth → Google).
# Android also needs an "Android" OAuth client with this app's package name and SHA-1.
GOOGLE_WEB_CLIENT_ID=YOUR-WEB-CLIENT-ID.apps.googleusercontent.com
# LiveKit keys are NOT here: they are Edge Function secrets
# (supabase secrets set LIVEKIT_URL=... LIVEKIT_API_KEY=... LIVEKIT_API_SECRET=...).
# Mesaj push bildirimi (isteğe bağlı; boşsa push kapalı). Firebase konsolu → Proje ayarları →
# Android uygulaması → google-services.json içinden: client.api_key.current_key, client.client_info.mobilesdk_app_id,
# project_info.project_number, project_info.project_id. google-services.json'u repoya koyma, gerekmez.
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_SENDER_ID=
FIREBASE_PROJECT_ID=
